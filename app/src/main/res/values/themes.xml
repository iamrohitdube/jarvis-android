<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="jarvis_navy">#FF03060C</color>

    <!-- Base window theme; Compose draws everything else. JARVIS is always dark (HUD look). -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- "Hey Jarvis" wake screen: full-screen pure black (OLED pixels off), no window chrome. -->
    <style name="Theme.Jarvis.Wake" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Launch screen (androidx core-splashscreen): navy background with the animated orb. -->
    <style name="Theme.Jarvis.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jarvis_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Jarvis</item>
    </style>
</resources>
