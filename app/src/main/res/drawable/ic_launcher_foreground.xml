<?xml version="1.0" encoding="utf-8"?>
<!--
  JARVIS orb: a glowing core inside a gradient ring with an orbiting arc.
  Drawn inside the 66dp adaptive-icon safe zone (centre 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer glow -->
    <path android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:startColor="#5522D3EE"
                android:centerColor="#224F6BFF"
                android:endColor="#004F6BFF" />
        </aapt:attr>
    </path>

    <!-- main ring -->
    <path
        android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
        android:strokeWidth="3.2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54"
                android:startColor="#FF4F6BFF"
                android:centerColor="#FF22D3EE"
                android:endColor="#FFA78BFA" />
        </aapt:attr>
    </path>

    <!-- orbiting arc -->
    <path
        android:pathData="M54,25 A29,29 0 0,1 83,54"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#CC8AF4FF"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,83 A29,29 0 0,1 31.5,72"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeColor="#99A78BFA"
        android:fillColor="#00000000" />

    <!-- core -->
    <path android:pathData="M54,54m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51"
                android:centerY="51"
                android:gradientRadius="14"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FF8AF4FF"
                android:endColor="#FF4F6BFF" />
        </aapt:attr>
    </path>
</vector>
