<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used to alert you if your JARVIS PIN gets locked (3 wrong tries). Asked for when you set a PIN. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Push-to-talk: the mic is used only while you hold a conversation turn. Asked for on first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets the app find a browser that supports Custom Tabs for OAuth sign-in (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Android 11+: needed to find the speech recognizer and the text-to-speech engine. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        tools:targetApi="37">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth redirect target: dev.jarvis://oauth/indmoney. Validates `state` before using the code. -->
        <activity
            android:name=".ui.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.jarvis" android:host="oauth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
